# ── Nexarion Sky Restaurant — frontend environment ────────────────────────────
# Copy to .env ONLY for ad-hoc local experimentation. The real per-environment
# values are injected at build time by GitHub Actions (see docs/PROVISIONING.md)
# and stored as GitHub Environment secrets/variables and Cloudflare secrets.
#
# RULES:
#   * VITE_* values end up in the public browser bundle. Only publishable keys here.
#   * NEVER put a service-role / secret key in any VITE_* variable or anywhere
#     reachable from the browser. Server-side-only keys belong in Supabase Edge
#     Function secrets or GitHub Actions secrets — never in this file.
#
# In CI these come from the GitHub Environment (development / staging / production)
# paired with the matching Supabase project.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
# One of: development | staging | production — drives UI env badge only.
VITE_APP_ENV=development
